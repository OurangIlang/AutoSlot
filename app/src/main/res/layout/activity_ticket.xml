<?xml version="1.0" encoding="utf-8"?>
<!-- Root: RelativeLayout | Tombol bawah: LinearLayout (weight) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnMore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_more" />

        <Button
            android:id="@+id/btnNewBooking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/btn_new_booking" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTicketHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/colorPrimary"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/ticket_header"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBookingCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTicketHeader"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textIsSelectable="true"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvBookingCode"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvQueue"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/ticket_note"
        android:textSize="12sp"
        android:textStyle="italic" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/tvNote"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView style="@style/FormLabel" android:text="@string/section_customer" />

            <LinearLayout
                android:id="@+id/llCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info"
                android:orientation="vertical"
                android:padding="12dp" />

            <TextView style="@style/FormLabel" android:text="@string/section_service" />

            <LinearLayout
                android:id="@+id/llService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info"
                android:orientation="vertical"
                android:padding="12dp" />

            <TextView style="@style/FormLabel" android:text="@string/section_cost" />

            <LinearLayout
                android:id="@+id/llCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info"
                android:orientation="vertical"
                android:padding="12dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
